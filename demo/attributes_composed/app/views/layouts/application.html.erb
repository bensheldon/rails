<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Attributes & composed_of demo" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= yield :head %>
    <%= stylesheet_link_tag :app %>
  </head>

  <body>
    <header class="site-header">
      <%= link_to "Attributes API & composed_of demo", root_path, class: "brand" %>
      <nav>
        <%= link_to "Products", products_path %>
        <%= link_to "New product", new_product_path %>
      </nav>
    </header>

    <main>
      <% if notice %>
        <p class="notice"><%= notice %></p>
      <% end %>
      <%= yield %>
    </main>
  </body>
</html>
